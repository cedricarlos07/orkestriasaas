# Local dev — http://localhost:8080

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:8080
# Optional comma-separated extra origins (production defaults include orkestria.top / .one)
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.orkestria.top
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# Email — Resend API (https://resend.com) — domain orkestria.top
# RESEND_API_KEY=re_...
# RESEND_FROM=Orkestria <hello@orkestria.top>
# RESEND_REPLY_TO=hello@orkestria.top
# RESEND_NOTIFY_TO=hello@orkestria.top

# User login OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ad platform OAuth (REQUIRED — no demo mode)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# REST version (v17–v19 sunset). Default v20.
# GOOGLE_ADS_API_VERSION=v20

GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=

META_APP_ID=
META_APP_SECRET=

TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=

X_ADS_CLIENT_ID=
X_ADS_CLIENT_SECRET=

AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Research — Meta Ad Library API officielle (ads_archive) via votre META_APP_ID/SECRET
# Pas de useproxy / ScrapeCreators. Ajoutez le produit « Ad Library API » dans Meta Developers.
# META_AD_LIBRARY_DEFAULT_COUNTRY=FR
# Couverture: pubs commerciales surtout UE/UK ; hors UE souvent politiques/issues seulement.


# Meta via adkit (https://github.com/jatinjain25/adkit) — subprocess adkit-mcp
# pipx install "meta-adkit[mcp]"
ADKIT_MCP_COMMAND=adkit-mcp
# ADKIT_MCP_ARGS=
# ADKIT_PROBE_TOKEN=   # optional health check
# ADKIT_PROBE_ACCOUNT=act_...
# META_PAGE_ID=        # default page if tool omits pageId
# META_INSTAGRAM_ACTOR_ID=
# GEMINI_API_KEY=      # optional — adkit generate_image/video
# ADVERTISER_URL=https://your-site.com

# Google via AdLoop self-hosted (pip install adloop && adloop init on server)
ADLOOP_MCP_COMMAND=python3
ADLOOP_MCP_ARGS=-m adloop
# ADLOOP_CONFIG=/root/.adloop/config.yaml
# ADLOOP_ENABLED=false

# Write actions — set true only after sandbox validation
MCP_WRITE_ENABLED=false

# LLM orchestrator — DeepSeek API (REQUIRED for chat beyond audit)
# https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MODEL_THINKING=deepseek-v4-flash

# Stripe Live billing (USD)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook URL: https://orkestria.top/api/stripe/webhook

# Mem0 self-hosted — long-term semantic memory per organization (VPS localhost only)
# Deploy: python scripts/_deploy_mem0.py
# Provider recommandé : Gemini (Google AI) — une seule clé pour LLM + embeddings Mem0
# Obtenir une clé : https://aistudio.google.com/apikey
# Doc : https://ai.google.dev/gemini-api/docs/api-key
# GEMINI_API_KEY=...          # utilisée par Orkestria (adkit) et copiée vers Mem0 comme GOOGLE_API_KEY
# MEM0_API_URL=http://127.0.0.1:8898
# MEM0_API_KEY=m0-...
# MEM0_ENABLED=true
# SKILLS_REPO_PATH=_vendor/ai-media-buying-skills
# Mem0 server (.env) — modèles validés avec cette clé :
# MEM0_DEFAULT_LLM_MODEL=gemini-flash-latest
# MEM0_DEFAULT_EMBEDDER_MODEL=models/gemini-embedding-001
# embedding_dims=1536 (aligné pgvector)
