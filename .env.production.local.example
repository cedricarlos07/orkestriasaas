# Production secrets for orkestria.top — copy to .env.production.local (gitignored via *.local)
#
# Meta Developer Console (developers.facebook.com):
#   1. App → Settings → Valid OAuth Redirect URIs:
#      https://orkestria.top/api/oauth/meta_ads/callback
#   2. App Review: ads_read + ads_management (Live mode or test users)
#   3. Paste App ID + App Secret below
#
# Apply to Openship: node scripts/sync-prod-env-to-openship.mjs
# (or patch Openship project proj_B9pE6w3WyxEphAYA env production)

META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_API_VERSION=v21.0
ADVERTISER_URL=https://your-site.com

DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MODEL_THINKING=deepseek-v4-flash

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Research — Meta Ad Library via META_APP_ID/SECRET (ads_archive)
# META_AD_LIBRARY_DEFAULT_COUNTRY=CI

# Ads — native Meta Graph + Google Ads API (no third-party MCP)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional embedder for Mastra semantic recall
# OPENAI_API_KEY=
# GEMINI_API_KEY=

MCP_WRITE_ENABLED=true

# Openship Mail SMTP (create mailbox in Openship Mail panel)
# Resend API (domain orkestria.top verified)
RESEND_API_KEY=
RESEND_FROM=Orkestria <hello@orkestria.top>
RESEND_REPLY_TO=hello@orkestria.top
RESEND_NOTIFY_TO=hello@orkestria.top
