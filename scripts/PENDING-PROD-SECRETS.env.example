# Secrets à ajouter quand tu les as (Openship → proj_B9pE6w3WyxEphAYA → env production)
#
# META_APP_ID=
# META_APP_SECRET=
# DEEPSEEK_API_KEY=
# Research — facebook-ads-library-mcp (self-host)
# SCRAPECREATORS_API_KEY=   # https://scrapecreators.com/
# GEMINI_API_KEY=           # optional video analysis
# FB_ADS_LIBRARY_MCP_COMMAND=/opt/facebook-ads-library-mcp/venv/bin/python
# FB_ADS_LIBRARY_MCP_ARGS=/opt/facebook-ads-library-mcp/mcp_server.py
# STRIPE_SECRET_KEY=       # rk_live_... or sk_live_...
# STRIPE_PUBLISHABLE_KEY=  # pk_live_...
# STRIPE_WEBHOOK_SECRET=   # whsec_... from Stripe webhook endpoint
# GOOGLE_ADS_CLIENT_ID=          (optional)
# GOOGLE_ADS_CLIENT_SECRET=      (optional)
# RESEND_API_KEY=re_...              # Resend API (domain orkestria.top)
# RESEND_FROM=Orkestria <hello@orkestria.top>
# RESEND_NOTIFY_TO=hello@orkestria.top
#
# Déjà configuré côté Openship (non-secret) :
# ADLOOP_MCP_COMMAND=python3
# ADLOOP_CONFIG=/root/.adloop/config.yaml
# ADKIT_MCP_COMMAND=adkit-mcp
# META_API_VERSION=v21.0
# MCP_WRITE_ENABLED=true
# FB_ADS_LIBRARY_MCP_COMMAND=/opt/facebook-ads-library-mcp/venv/bin/python
# FB_ADS_LIBRARY_MCP_ARGS=/opt/facebook-ads-library-mcp/mcp_server.py
#
# Sync : remplir ce fichier → copier en .env.production.local → node scripts/sync-prod-env-to-openship.mjs
