# Secrets à ajouter (Openship → env production)
#
# META_APP_ID=
# META_APP_SECRET=
# DEEPSEEK_API_KEY=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=   # MCC si besoin
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=Orkestria <hello@orkestria.top>
# RESEND_NOTIFY_TO=hello@orkestria.top
#
# Déjà typiques côté Openship (non-secret) :
# META_API_VERSION=v21.0
# MCP_WRITE_ENABLED=true
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
#
# Sync : remplir → .env.production.local → node scripts/sync-prod-env-to-openship.mjs
